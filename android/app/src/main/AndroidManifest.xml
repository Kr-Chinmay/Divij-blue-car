<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- screenOrientation is locked to portrait. The game is a fixed
             portrait canvas; landscape would letterbox it into a stripe down
             the middle of the screen. Locking it here rather than hoping is
             what stops a child rotating the phone mid-run.

             windowSoftInputMode is adjustNothing: when the keyboard opens,
             do not resize the window and do not pan it. Without this Android
             shrinks the web view, Phaser sees the window change size and
             rescales the whole canvas, and the name box is dragged away from
             the card it belongs to.

             The Capacitor keyboard setting alone did not achieve this - the
             activity's own soft-input mode was still winning, which is why
             the first attempt at this made matters worse rather than better.
             The keyboard now draws on top, and the finish card lifts itself
             clear in code. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- AdMob application id - the real one, from Chinmay's account.

             This identifies the account. Whether a real advert or a sample
             one is actually served is decided separately, by CONFIG.AD_TESTING
             in the game. That stays true until release, so this phone gets
             sample adverts while the correct id sits in place.

             The reason for the split: impressions and clicks from the
             developer's own device count as invalid traffic, and are one of
             the commonest ways an AdMob account is suspended before it has
             earned anything.

             Note the tilde. An APP id has one; an AD UNIT id has a slash
             instead. They look nearly identical and swapping them produces
             adverts that silently never load. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4959005944172118~7717726921" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
